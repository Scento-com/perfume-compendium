{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.scento/perfume-api",
  "title": "Scento Perfume API (MCP server)",
  "description": "Free perfume & fragrance API and MCP server: notes, families, similar scents, 1,400+ perfumes.",
  "version": "1.0.0",
  "websiteUrl": "https://www.scento.com/developers",
  "repository": {
    "url": "https://github.com/Scento-com/perfume-mcp-server",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.scento.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "scento-perfume-api",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "pypi",
      "identifier": "scento-perfume-api",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
